APP_NAME="Darasa Academics"
APP_ENV=sandbox
APP_KEY=
APP_DEBUG=true
APP_URL=https://academics-sandbox.darasa360.com

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=darasa_sandbox_academics_tenant
DB_USERNAME=darasa_user
DB_PASSWORD=

# ── Platform (shared) DB ─────────────────────────────────────────────────────
PLATFORM_DB_HOST=127.0.0.1
PLATFORM_DB_PORT=3306
PLATFORM_DB_DATABASE=darasa_platform
PLATFORM_DB_USERNAME=darasa_user
PLATFORM_DB_PASSWORD=

# ── Cross-system URLs ─────────────────────────────────────────────────────────
FINANCE_APP_URL=https://finance-sandbox.darasa360.com

MAIL_MAILER=log
MAIL_FROM_ADDRESS=noreply@darasa360.com
MAIL_FROM_NAME="Darasa360"

CACHE_DRIVER=file
SESSION_DRIVER=file
QUEUE_CONNECTION=sync
