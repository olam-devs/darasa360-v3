APP_NAME="Darasa Finance"
APP_ENV=sandbox
APP_KEY=
APP_DEBUG=true
APP_URL=https://finance-sandbox.darasa360.com

LOG_CHANNEL=stack
LOG_LEVEL=debug

# ── Tenant DB (default connection — set per school via provisioning) ──────────
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=darasa_sandbox_tenant
DB_USERNAME=darasa_user
DB_PASSWORD=

# ── Central DB ───────────────────────────────────────────────────────────────
CENTRAL_DB_HOST=127.0.0.1
CENTRAL_DB_PORT=3306
CENTRAL_DB_DATABASE=darasa_central
CENTRAL_DB_USERNAME=darasa_user
CENTRAL_DB_PASSWORD=

# ── Platform (shared) DB ─────────────────────────────────────────────────────
PLATFORM_DB_HOST=127.0.0.1
PLATFORM_DB_PORT=3306
PLATFORM_DB_DATABASE=darasa_platform
PLATFORM_DB_USERNAME=darasa_user
PLATFORM_DB_PASSWORD=

# ── Cross-system URLs ─────────────────────────────────────────────────────────
ACADEMICS_APP_URL=https://academics-sandbox.darasa360.com
ACADEMICS_APP_PATH=/home/olamtecc/domains/academics-sandbox.darasa360.co.tz/public_html/academics
ACADEMICS_MAIN_DB=olamtecc_academics_sandbox

# ── Mail ─────────────────────────────────────────────────────────────────────
MAIL_MAILER=log
MAIL_FROM_ADDRESS=noreply@darasa360.com
MAIL_FROM_NAME="Darasa360"

# ── SMS ──────────────────────────────────────────────────────────────────────
BEEM_API_KEY=
BEEM_SECRET_KEY=
BEEM_SENDER_NAME=DARASA

CACHE_DRIVER=file
SESSION_DRIVER=file
QUEUE_CONNECTION=sync
